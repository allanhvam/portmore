{
  "name": "portmore",
  "version": "1.1.0",
  "description": "A portless process wrapper that assigns and aliases free ports for local in process service orchestration.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/allanhvam/portmore.git"
  },
  "files": [
    "docs",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && npx portless run --name demo node dist/demo.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist",
    "test": "echo \"No tests yet\""
  },
  "keywords": [
    "portless",
    "ports",
    "local-development",
    "service-orchestration",
    "dashboard"
  ],
  "author": "Allan Hvam",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.4.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "portless": "^0.13.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "hono": "^4.12.7"
  }
}
